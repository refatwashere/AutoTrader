# PostgreSQL connection string. Use a dedicated database and a strong password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required to encrypt built-in custody wallet keys. Generate a fresh 32-byte key
# for each environment, for example: openssl rand -hex 32
CUSTODY_ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional Base RPC endpoint. Defaults to https://mainnet.base.org
# BASE_RPC_URL=https://mainnet.base.org
